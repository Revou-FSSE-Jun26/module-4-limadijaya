# Copy to backend/.env for local development. Never commit .env.
# Production values are set only in the Render environment settings (NFR-002-AC03).
# Every value below is a placeholder, not a real or recommended value.

# Required
# PostgreSQL connection string. Production uses the Supabase session-mode pooler (DA-16).
DATABASE_URL=postgresql://<user>:<password>@<session-pooler-host>:<port>/<database>?sslmode=require
JWT_SECRET_KEY=<long-random-secret>
# Token lifetime in seconds. No default exists: the value is decided under UD-01.
JWT_ACCESS_TOKEN_EXPIRES_SECONDS=<seconds-decided-under-UD-01>
# Exact frontend origin allowed for the health route CORS response.
FRONTEND_ORIGIN=https://your-app.example

# Tests only: a PostgreSQL database separate from production (TEST-001-AC03).
TEST_DATABASE_URL=postgresql://<user>:<password>@<test-host>:<port>/<test-database>

# Optional
# LOG_LEVEL=<logging-level-name>
# SQLAlchemy pool sizes: small, values set during verification V-02 (DA-16).
# DB_POOL_SIZE=<small-integer>
# DB_MAX_OVERFLOW=<small-integer>
