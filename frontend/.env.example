# Copy to frontend/.env.local for local development. Never commit .env.local.
# Production values are set only in the Vercel environment settings (NFR-002-AC03).
# Every value below is a placeholder, not a real value.

# Server only. Base URL of the Flask API on Render. Used by Server Components and the BFF proxy.
API_BASE_URL=https://your-render-service.example

# PUBLIC: this value is sent to the browser, so it must never hold a secret.
# Used only for the direct GET /api/health call.
NEXT_PUBLIC_API_BASE_URL=https://your-render-service.example

# Server only. Comma-separated list of exact trusted origins for the CSRF Origin check
# (DA-04, FE-05). Wildcards are not allowed, and a preview origin is trusted only when listed.
APP_ORIGIN=https://your-app.example
